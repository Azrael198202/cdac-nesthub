{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution Method Contract",
  "type": "object",
  "required": ["method", "confidence", "input_schema", "output_schema", "cost_level", "latency_level", "fallback"],
  "properties": {
    "method": {
      "type": "string",
      "enum": ["runtime_generated_tool", "existing_tool", "web_search", "knowledge_base", "model_knowledge", "api_call"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "input_schema": {"type": "object"},
    "output_schema": {"type": "object"},
    "cost_level": {"type": "string"},
    "latency_level": {"type": "string"},
    "fallback": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string"},
    "proposal_source": {"type": "string"},
    "decision_source": {"type": "string"}
  },
  "additionalProperties": true
}
