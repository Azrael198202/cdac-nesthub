{
  "version": "1.0",
  "description": "Generic runtime capability inference rules. Core code only loads this file; semantic trigger terms are runtime policy data.",
  "rules": [
    {
      "rule_id": "current_observation_from_runtime_context",
      "capability": "runtime_current_observation",
      "confidence": 0.92,
      "match_any_token_sets": [
        [
          "current",
          "time"
        ],
        [
          "now"
        ],
        [
          "present",
          "time"
        ],
        [
          "runtime",
          "observation"
        ]
      ],
      "default_parameters": {
        "known": {
          "timezone": "system_default"
        },
        "optional": {},
        "missing_required": {}
      },
      "execution_strategy": [
        "tool_generation"
      ],
      "metadata": {
        "source": "runtime_policy",
        "notes": "Used when a planner describes a current runtime observation but does not assign a concrete capability."
      }
    }
  ]
}