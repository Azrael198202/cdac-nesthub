{
  "preserve": [
    "ai_core/**/*.py",
    "ai_core/secrets/**/*.py",
    "configs/**/*.yaml",
    "configs/**/*.json",
    "schemas/**/*.json",
    "runtime/.gitkeep",
    "README.md",
    "VERSION.txt",
    "requirements.txt",
    "main.py"
  ],
  "exclude": [
    "runtime/configs/secrets/**",
    "runtime/generated/**",
    "runtime/traces/**",
    "runtime/checkpoints/**",
    "runtime/cache/**",
    "runtime/results/**",
    "runtime/temp/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/.DS_Store"
  ]
}
