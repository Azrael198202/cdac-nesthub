{
  "version": "2.9.16",
  "description": "Generic runtime execution-source policy. Concrete domain vocabulary belongs to runtime-generated contracts, not source code.",
  "preferred_execution_modes": [
    "structured_provider",
    "web_retrieval",
    "runtime_native"
  ],
  "strict_source_alignment": true,
  "routing_rules": [
    {
      "execution_mode": "runtime_native",
      "match_scope": "capability_semantics",
      "semantic_categories": [
        "runtime_state_observation"
      ],
      "indicators": [
        "runtime_state",
        "runtime_native",
        "system_state",
        "local_runtime",
        "current_runtime_state",
        "system clock",
        "local machine"
      ]
    },
    {
      "execution_mode": "structured_provider",
      "match_scope": "capability_semantics",
      "semantic_categories": [
        "external_state_observation",
        "structured_external_observation",
        "remote_structured_data"
      ],
      "indicators": [
        "external_state",
        "external_observation",
        "structured_provider",
        "structured source",
        "api preferred",
        "remote state",
        "volatile external state"
      ]
    },
    {
      "execution_mode": "web_retrieval",
      "match_scope": "execution_strategy",
      "strategy_values": [
        "web_evidence",
        "web_retrieval",
        "external_evidence"
      ]
    }
  ],
  "fallback_modes": [
    "structured_provider",
    "web_retrieval"
  ],
  "deny_runtime_native_when": [
    {
      "execution_strategy_contains": [
        "web_evidence",
        "web_retrieval",
        "external_evidence"
      ]
    },
    {
      "source_required": [
        "structured_provider",
        "web_retrieval"
      ]
    }
  ],
  "unknown_capability_default": "web_retrieval",
  "execution_method_policy": {
    "description": "Generic method-selection policy. LLM/workflow output is treated as proposal; runtime resolver makes the final decision from contracts.",
    "allowed_methods": [
      "runtime_generated_tool",
      "existing_tool",
      "web_search",
      "knowledge_base",
      "model_knowledge",
      "api_call"
    ],
    "contract_required": true,
    "llm_output_role": "proposal_only",
    "runtime_decision_role": "deterministic_resolver",
    "required_contract_fields": [
      "input_schema",
      "output_schema",
      "confidence",
      "cost_level",
      "latency_level",
      "fallback"
    ]
  },
  "preferred_methods": [
    "existing_tool",
    "runtime_generated_tool",
    "api_call",
    "web_search",
    "knowledge_base",
    "model_knowledge"
  ]
}