{
  "version": "2.9.0",
  "description": "Generic semantic capability taxonomy. Concrete domain aliases are generated at runtime under runtime/generated/contracts.",
  "capability_semantic_graph": {
    "runtime_state_observation": {
      "preferred_modes": ["runtime_native"],
      "fallback_modes": [],
      "indicators": [
        "runtime_state",
        "runtime native",
        "local runtime",
        "system state",
        "system clock",
        "local machine",
        "current_runtime_state"
      ]
    },
    "structured_external_observation": {
      "preferred_modes": ["structured_provider", "web_retrieval"],
      "fallback_modes": ["web_retrieval", "mcp_orchestration"],
      "indicators": [
        "external state",
        "external observation",
        "live external",
        "remote structured data",
        "volatile external state",
        "api preferred"
      ]
    },
    "web_retrieval": {
      "preferred_modes": ["web_retrieval"],
      "fallback_modes": ["structured_provider", "mcp_orchestration"],
      "indicators": [
        "web evidence",
        "web_evidence",
        "search",
        "external evidence",
        "latest",
        "current external"
      ]
    },
    "artifact_generation": {
      "preferred_modes": ["specialized_model", "tool_generation"],
      "fallback_modes": ["strong_reasoning", "mcp_orchestration"],
      "indicators": [
        "artifact",
        "file generation",
        "document generation",
        "media generation",
        "code generation"
      ]
    },
    "mcp_orchestration": {
      "preferred_modes": ["mcp_orchestration", "tool_generation"],
      "fallback_modes": ["web_retrieval"],
      "indicators": [
        "mcp",
        "external tool server",
        "capability manifest",
        "tool discovery"
      ]
    }
  }
}
