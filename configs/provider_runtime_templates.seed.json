{
  "version": "2.9.4",
  "policy_kind": "runtime_provider_execution_templates",
  "description": "Generic provider/runtime usage methods for model/tool execution. This file describes how a provider is prepared, registered, invoked, and validated without encoding business-domain logic.",
  "global_rules": {
    "schema_first": true,
    "runtime_generated_allowed": true,
    "human_review_for_external_downloads": true,
    "human_review_for_new_network_provider": true,
    "record_provenance": true,
    "secret_values_must_not_be_written_to_files": true
  },
  "provider_types": {
    "ollama_model": {
      "kind": "local_service_model",
      "prepare_steps": [
        "ensure_binary",
        "ensure_service",
        "ensure_model"
      ],
      "install_method": {
        "binary": "ollama",
        "commands": {
          "linux": [
            "curl -fsSL https://ollama.com/install.sh | sh"
          ],
          "macos": [
            "brew install ollama"
          ],
          "windows": [
            "winget install Ollama.Ollama --accept-source-agreements --accept-package-agreements --disable-interactivity"
          ]
        }
      },
      "model_download_method": {
        "command_template": "{binary} pull {model}",
        "timeout_seconds": 3600
      },
      "service_method": {
        "start_command": "{binary} serve",
        "healthcheck": {
          "method": "GET",
          "path": "/api/tags"
        }
      },
      "invoke_methods": {
        "chat": {
          "method": "POST",
          "path": "/api/chat",
          "request_format": "ollama_chat",
          "response_path": [
            "message",
            "content"
          ]
        },
        "generate": {
          "method": "POST",
          "path": "/api/generate",
          "request_format": "ollama_generate",
          "response_path": [
            "response"
          ]
        }
      },
      "input_contract": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string"
          },
          "system": {
            "type": "string"
          },
          "schema": {
            "type": "object"
          },
          "model": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "output_contract": {
        "type": "object",
        "required": [
          "status",
          "data",
          "source"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "openai_compatible_api": {
      "kind": "remote_api_model",
      "prepare_steps": [
        "resolve_secret",
        "healthcheck_optional"
      ],
      "auth_method": {
        "type": "bearer_env",
        "env_key_field": "auth_env"
      },
      "invoke_methods": {
        "chat_completions": {
          "method": "POST",
          "path": "/v1/chat/completions",
          "request_format": "chat_completions",
          "response_path": [
            "choices",
            0,
            "message",
            "content"
          ]
        }
      },
      "input_contract": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string"
          },
          "system": {
            "type": "string"
          },
          "schema": {
            "type": "object"
          },
          "model": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "output_contract": {
        "type": "object",
        "required": [
          "status",
          "data",
          "source"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "huggingface_snapshot": {
      "kind": "local_model_artifact",
      "prepare_steps": [
        "license_gate",
        "snapshot_download",
        "runtime_binding"
      ],
      "download_method": {
        "python_package": "huggingface_hub",
        "function": "snapshot_download"
      },
      "invoke_methods": {
        "local_command": {
          "method": "command",
          "request_format": "json_stdin",
          "response_format": "json_stdout"
        },
        "python_function": {
          "method": "python_function",
          "request_format": "dict",
          "response_format": "dict"
        }
      },
      "input_contract": {
        "type": "object",
        "additionalProperties": true
      },
      "output_contract": {
        "type": "object",
        "required": [
          "status",
          "data",
          "source"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "generic_http_json": {
      "kind": "remote_api_or_local_http_service",
      "prepare_steps": [
        "resolve_secret_optional",
        "healthcheck_optional"
      ],
      "invoke_methods": {
        "request": {
          "method": "HTTP",
          "request_format": "json",
          "response_format": "json"
        }
      },
      "input_contract": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "headers": {
            "type": "object"
          },
          "json": {
            "type": "object"
          }
        },
        "additionalProperties": true
      },
      "output_contract": {
        "type": "object",
        "required": [
          "status",
          "data",
          "source"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "local_command": {
      "kind": "local_executable",
      "prepare_steps": [
        "ensure_binary_or_script"
      ],
      "invoke_methods": {
        "command": {
          "method": "command",
          "request_format": "json_stdin",
          "response_format": "json_stdout"
        }
      },
      "input_contract": {
        "type": "object",
        "additionalProperties": true
      },
      "output_contract": {
        "type": "object",
        "required": [
          "status",
          "data",
          "source"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "python_function": {
      "kind": "runtime_python_module",
      "prepare_steps": [
        "validate_module",
        "validate_callable"
      ],
      "invoke_methods": {
        "call": {
          "method": "python_function",
          "request_format": "dict",
          "response_format": "dict"
        }
      },
      "input_contract": {
        "type": "object",
        "additionalProperties": true
      },
      "output_contract": {
        "type": "object",
        "required": [
          "status",
          "data",
          "source"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "vllm_model": {
      "kind": "local_service_model_openai_compatible",
      "prepare_steps": [
        "ensure_python_package",
        "ensure_service",
        "ensure_model_or_served_model_name"
      ],
      "install_method": {
        "python_package": "vllm",
        "commands": {
          "linux": [
            "python -m pip install vllm"
          ],
          "macos": [
            "python -m pip install vllm"
          ],
          "windows": [
            "Use WSL2/Linux or a compatible OpenAI-compatible local server; native Windows vLLM is not assumed."
          ]
        }
      },
      "service_method": {
        "start_command": "python -m vllm.entrypoints.openai.api_server --host 127.0.0.1 --port {port} --model {model}",
        "default_port": 8001,
        "healthcheck": {
          "method": "GET",
          "path": "/v1/models"
        },
        "api_protocol": "openai_compatible"
      },
      "invoke_methods": {
        "chat_completions": {
          "method": "POST",
          "path": "/v1/chat/completions",
          "request_format": "chat_completions",
          "response_path": [
            "choices",
            0,
            "message",
            "content"
          ]
        }
      },
      "input_contract": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string"
          },
          "system": {
            "type": "string"
          },
          "schema": {
            "type": "object"
          },
          "model": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "output_contract": {
        "type": "object",
        "required": [
          "status",
          "data",
          "source"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "capability_bindings": {
    "text_generation": [
      "vllm_model",
      "ollama_model",
      "openai_compatible_api",
      "huggingface_snapshot"
    ],
    "structured_json_generation": [
      "vllm_model",
      "ollama_model",
      "openai_compatible_api"
    ],
    "code_generation": [
      "vllm_model",
      "ollama_model",
      "openai_compatible_api",
      "huggingface_snapshot",
      "local_command"
    ],
    "speech_to_text": [
      "generic_http_json",
      "local_command",
      "python_function",
      "openai_compatible_api"
    ],
    "text_to_speech": [
      "generic_http_json",
      "local_command",
      "python_function",
      "openai_compatible_api"
    ],
    "image_understanding": [
      "vllm_model",
      "generic_http_json",
      "ollama_model",
      "openai_compatible_api",
      "python_function"
    ],
    "image_generation": [
      "generic_http_json",
      "local_command",
      "python_function",
      "openai_compatible_api"
    ],
    "image_editing": [
      "generic_http_json",
      "local_command",
      "python_function",
      "openai_compatible_api"
    ],
    "video_understanding": [
      "generic_http_json",
      "local_command",
      "python_function",
      "openai_compatible_api"
    ],
    "video_generation": [
      "generic_http_json",
      "local_command",
      "python_function",
      "openai_compatible_api"
    ],
    "document_generation": [
      "python_function",
      "local_command",
      "generic_http_json"
    ],
    "spreadsheet_generation": [
      "python_function",
      "local_command"
    ],
    "slide_generation": [
      "python_function",
      "local_command",
      "generic_http_json"
    ],
    "pdf_generation": [
      "python_function",
      "local_command"
    ],
    "diagram_generation": [
      "python_function",
      "local_command",
      "generic_http_json"
    ]
  },
  "runtime_artifact_contract": {
    "required_fields": [
      "provider_id",
      "provider_type",
      "input_schema",
      "output_schema",
      "invoke"
    ],
    "invoke_required_fields": [
      "method"
    ],
    "supported_invoke_methods": [
      "ollama_chat",
      "ollama_generate",
      "chat_completions",
      "http_json",
      "command",
      "python_function"
    ]
  }
}